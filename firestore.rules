rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to check if the user is an authenticated super administrator
    function isSuperAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'idowutosin70@gmail.com' || 
        request.auth.token.email == 'server-admin@tizzitech.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin'
      );
    }

    // Helper to check if the user is authenticated and owns the resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Admins registry: only super administrator can read/write directly.
    match /admins/{adminId} {
      allow read, write: if isSuperAdmin();
    }

    // Admin OTP credentials & Admin active sessions:
    // Only accessible by super admin or internal server logic (bypasses direct public tampering)
    match /admin_otps/{otpId} {
      allow read, write: if isSuperAdmin();
    }

    match /admin_sessions/{sessionId} {
      allow read, write: if isSuperAdmin();
    }

    // Products: public read-only catalog. Writing/updating restricted to super administrators.
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Settings: public read-only store configuration. Writing restricted to super administrators.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Coupons: public read to check validity. Modifying restricted to super administrators.
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Orders: allow create for checkout flow; read/update restricted to super admin or the authenticated owner.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
    }

    // Order items sub-collection / records:
    match /order_items/{itemId} {
      allow create: if true;
      allow read: if isSuperAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || resource.data.email == request.auth.token.email));
      allow update, delete: if isSuperAdmin();
    }

    // Users: only the authenticated user owning the record or a super admin can read/write their profile.
    match /users/{userId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin() || isOwner(userId) || (request.auth != null && resource.data.email == request.auth.token.email);
    }

    // Audit logs & Security logs: only super admins can read; writes allowed for logging (cannot update or delete)
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /security_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /client_error_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /analytics_visits/{visitId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /newsletter_subscribers/{subId} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Strict default-deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


