{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product for sale in the store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "condition": { "type": "string" },
        "stock": { "type": "number" },
        "imageUrl": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "category", "brand", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Picked Up", "Delivered", "Cancelled"] },
        "orderDate": { "type": "string" },
        "customerInfo": { "type": "object" }
      },
      "required": ["id", "items", "total", "status", "orderDate"]
    },
    "User": {
      "title": "User",
      "description": "Registered customer profile.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "firstname": { "type": "string" },
        "lastname": { "type": "string" },
        "role": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Promotional discount codes.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercentage": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["code", "discountPercentage", "status"]
    },
    "SecurityLog": {
      "title": "SecurityLog",
      "description": "Security audit event log.",
      "type": "object",
      "properties": {
        "eventType": { "type": "string" },
        "severity": { "type": "string" },
        "ip": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["eventType", "severity", "timestamp"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "Subscribers and VIP waitlist entries.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "status": { "type": "string" },
        "subscribedAt": { "type": "string" }
      },
      "required": ["email", "status"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global store settings like categories, brands, and hero configuration.",
      "type": "object",
      "properties": {
        "categories": { "type": "array" },
        "brands": { "type": "array" },
        "deliveryZones": { "type": "array" },
        "heroConfig": { "type": "object" }
      }
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Products available in the store."
    },
    "orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders."
    },
    "users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Customer account records."
    },
    "coupons/{couponId}": {
      "schema": { "$ref": "#/entities/Coupon" },
      "description": "Store discount coupons."
    },
    "audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/SecurityLog" },
      "description": "Administrative and server audit trail."
    },
    "security_logs/{logId}": {
      "schema": { "$ref": "#/entities/SecurityLog" },
      "description": "Security events and abnormal traffic logs."
    },
    "newsletter_subscribers/{subId}": {
      "schema": { "$ref": "#/entities/NewsletterSubscriber" },
      "description": "Newsletter and waitlist subscriptions."
    },
    "settings/{settingId}": {
      "schema": { "$ref": "#/entities/Settings" },
      "description": "Store settings (e.g., globals)."
    }
  }
}
