# ==========================================
# TIZZITECH PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

# Application URL for canonical links, callbacks, and notification redirects
APP_URL=

# Primary Store Administrator Email (receives order alerts, contact messages, and admin access)
ADMIN_EMAIL=idowutosin70@gmail.com
# Additional authorized admin emails (comma-separated list, optional)
ADDITIONAL_ADMIN_EMAILS=

# Cryptographic secret for signing JSON Web Tokens (JWT) (64+ character random string in production)
JWT_SECRET=

# Secret passkey for validating administrative operations (Must be set to a strong secret in production)
ADMIN_KEY=

# Paystack Payment Gateway API keys
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Google Authentication & Maps API Configuration
VITE_GOOGLE_CLIENT_ID=
GOOGLE_MAPS_PLATFORM_KEY=

# Cloudinary Storage for media uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP Email Dispatch Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Optional Supabase Connection Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini AI Features (Server-Side)
GEMINI_API_KEY=
